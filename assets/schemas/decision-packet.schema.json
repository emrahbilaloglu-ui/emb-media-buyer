{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/emb-media-buyer/decision-packet.schema.json",
  "title": "Media Buyer Decision Packet",
  "$defs": {
    "auditText": {"type": "string", "minLength": 1},
    "auditTime": {"type": "string", "format": "date-time"},
    "auditRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/auditText"}},
    "ledgerValue": {"type": ["number", "null"], "minimum": 0},
    "creativeWindow": {
      "type": "object", "required": ["start_date", "end_date"],
      "properties": {"start_date": {"type": "string", "format": "date"}, "end_date": {"type": "string", "format": "date"}}
    },
    "creativeMetricCondition": {
      "type": "object", "required": ["kind", "window", "metric", "op", "value", "source"],
      "properties": {
        "kind": {"const": "metric"}, "window": {"$ref": "#/$defs/creativeWindow"},
        "metric": {"enum": ["spend", "impressions", "lpv", "atc", "checkout", "purchases"]},
        "op": {"enum": ["lt", "lte", "eq", "gte", "gt"]}, "value": {"type": "number", "minimum": 0},
        "source": {"$ref": "#/$defs/auditText"}
      }
    },
    "creativeWatch": {
      "type": "object", "required": ["basis", "question", "due_at", "condition", "wait_cost"],
      "properties": {
        "basis": {
          "type": "object", "required": ["kind"],
          "properties": {
            "kind": {"enum": ["first_checkout", "low_opportunity", "first_clean_window", "material_credit", "technical_change", "approved_retention"]},
            "window": {"$ref": "#/$defs/creativeWindow"}, "metric": {"enum": ["spend", "impressions", "lpv"]},
            "value": {"type": "number", "minimum": 0}, "source": {"$ref": "#/$defs/auditText"},
            "event_id": {"$ref": "#/$defs/auditText"}
          },
          "allOf": [
            {"if": {"properties": {"kind": {"enum": ["first_checkout", "first_clean_window"]}}}, "then": {"required": ["window"]}},
            {"if": {"properties": {"kind": {"const": "low_opportunity"}}}, "then": {"required": ["window", "metric", "value", "source"]}},
            {"if": {"properties": {"kind": {"enum": ["material_credit", "technical_change"]}}}, "then": {"required": ["event_id"]}}
          ]
        },
        "question": {"$ref": "#/$defs/auditText"}, "due_at": {"$ref": "#/$defs/auditTime"},
        "condition": {
          "oneOf": [
            {"$ref": "#/$defs/creativeMetricCondition"},
            {"type": "object", "required": ["kind", "event_type", "expected_state", "source"], "properties": {
              "kind": {"const": "technical_event"}, "event_type": {"$ref": "#/$defs/auditText"},
              "expected_state": {"$ref": "#/$defs/auditText"}, "source": {"$ref": "#/$defs/auditText"}
            }}
          ]
        },
        "wait_cost": {
          "oneOf": [
            {"type": "object", "required": ["kind", "currency", "lower", "upper", "source"], "properties": {
              "kind": {"const": "estimated_range"}, "currency": {"$ref": "#/$defs/auditText"},
              "lower": {"type": "number", "minimum": 0}, "upper": {"type": "number", "minimum": 0},
              "source": {"$ref": "#/$defs/auditText"}
            }},
            {"type": "object", "required": ["kind", "condition", "source"], "properties": {
              "kind": {"const": "observable_bound"}, "condition": {"$ref": "#/$defs/creativeMetricCondition", "properties": {"metric": {"enum": ["spend", "impressions"]}}},
              "source": {"$ref": "#/$defs/auditText"}
            }}
          ]
        },
        "legacy_resolution": {"type": "object", "required": ["prior_as_of", "outcome", "rationale"], "properties": {
          "prior_as_of": {"$ref": "#/$defs/auditTime"}, "outcome": {"const": "retired_unstructured"}, "rationale": {"$ref": "#/$defs/auditText"}
        }}
      }
    },
    "creativePerformanceReview": {
      "type": "object", "required": ["window", "observed", "assessment", "rationale", "counterevidence"],
      "properties": {
        "window": {"enum": ["lifecycle", "last_3_closed", "last_7_closed", "partial_day", "current_epoch"]},
        "assessment": {"enum": ["adequate", "limited", "unresolved"]},
        "rationale": {"$ref": "#/$defs/auditText"}, "counterevidence": {"$ref": "#/$defs/auditText"},
        "observed": {"type": "object", "required": ["spend", "impressions", "lpv", "atc", "checkout", "purchases", "purchase_value", "cpa", "roas"], "additionalProperties": {"$ref": "#/$defs/ledgerValue"}}
      }
    },
    "ledgerObservation": {
      "type": "object",
      "required": ["spend", "platform_outcomes", "merchant_outcomes"],
      "properties": {
        "spend": {"$ref": "#/$defs/ledgerValue"},
        "platform_outcomes": {"$ref": "#/$defs/ledgerValue"},
        "merchant_outcomes": {"$ref": "#/$defs/ledgerValue"}
      }
    },
    "auditContinuation": {
      "type": "object",
      "required": [
        "current", "prior", "increment", "change_kind", "basis", "rationale",
        "expected_information", "cost_of_waiting", "cost_of_stopping", "exposure_context",
        "next_read_at", "trigger", "evidence_ids"
      ],
      "properties": {
        "current": {"$ref": "#/$defs/ledgerObservation"},
        "prior": {
          "oneOf": [
            {"type": "null"},
            {
              "$ref": "#/$defs/ledgerObservation",
              "required": ["as_of", "evidence_ids", "currency", "timezone", "attribution", "report_time", "start_date"],
              "dependentRequired": {"rationale": ["next_read_at"], "next_read_at": ["rationale"]},
              "properties": {
                "as_of": {"$ref": "#/$defs/auditTime"},
                "evidence_ids": {"$ref": "#/$defs/auditRefs"},
                "currency": {"$ref": "#/$defs/auditText"},
                "timezone": {"$ref": "#/$defs/auditText"},
                "attribution": {"$ref": "#/$defs/auditText"},
                "report_time": {"$ref": "#/$defs/auditText"},
                "start_date": {"type": "string", "format": "date"},
                "rationale": {"$ref": "#/$defs/auditText"},
                "next_read_at": {"$ref": "#/$defs/auditTime"}
              }
            }
          ]
        },
        "increment": {
          "type": ["object", "null"],
          "required": ["spend", "platform_outcomes", "merchant_outcomes"],
          "properties": {
            "spend": {"type": ["number", "null"]},
            "platform_outcomes": {"type": ["number", "null"]},
            "merchant_outcomes": {"type": ["number", "null"]}
          }
        },
        "change_kind": {"enum": ["first_read", "new_information", "unchanged", "attribution_revision"]},
        "revision_explanation": {"$ref": "#/$defs/auditText"},
        "basis": {"enum": ["economic_case", "test_information", "binding_or_lag", "approved_retention"]},
        "rationale": {"$ref": "#/$defs/auditText"},
        "expected_information": {"$ref": "#/$defs/auditText"},
        "cost_of_waiting": {"$ref": "#/$defs/auditText"},
        "cost_of_stopping": {"$ref": "#/$defs/auditText"},
        "exposure_context": {"$ref": "#/$defs/auditText"},
        "next_read_at": {"$ref": "#/$defs/auditTime"},
        "evidence_ids": {"$ref": "#/$defs/auditRefs"},
        "merchant_evidence_ids": {"$ref": "#/$defs/auditRefs"},
        "watch_contract": {"$ref": "#/$defs/creativeWatch"},
        "trigger": {
          "type": "object",
          "required": ["condition", "state", "response"],
          "properties": {
            "condition": {"$ref": "#/$defs/auditText"},
            "state": {"enum": ["pending", "met", "unknown"]},
            "response": {"$ref": "#/$defs/auditText"},
            "reassessment": {"$ref": "#/$defs/auditText"}
          },
          "if": {"properties": {"state": {"const": "met"}}},
          "then": {"required": ["reassessment"]}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"change_kind": {"const": "first_read"}}},
          "then": {"properties": {"prior": {"type": "null"}, "increment": {"type": "null"}}},
          "else": {"properties": {"prior": {"type": "object"}, "increment": {"type": "object"}}}
        },
        {
          "if": {"properties": {"change_kind": {"const": "attribution_revision"}}},
          "then": {"required": ["revision_explanation"]}
        }
      ]
    },
    "creativeTestBasis": {
      "type": "object",
      "required": ["kind", "evidence_ids", "rationale"],
      "properties": {
        "kind": {"enum": ["observed_ad_performance", "observed_post_rotation", "verified_independent_issue"]},
        "evidence_ids": {"$ref": "#/$defs/auditRefs"},
        "rationale": {"$ref": "#/$defs/auditText"},
        "metric_window": {"enum": ["lifecycle", "last_3_closed", "last_7_closed"]},
        "anchor_ad_id": {"$ref": "#/$defs/auditText"},
        "window_start": {"type": "string", "format": "date"},
        "window_end": {"type": "string", "format": "date"},
        "issue_type": {"enum": ["policy", "destination", "measurement", "owner_guardrail"]},
        "event_id": {"$ref": "#/$defs/auditText"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "observed_ad_performance"}}}, "then": {"required": ["metric_window"]}},
        {"if": {"properties": {"kind": {"const": "observed_post_rotation"}}}, "then": {"required": ["anchor_ad_id", "window_start", "window_end"]}},
        {"if": {"properties": {"kind": {"const": "verified_independent_issue"}}}, "then": {"required": ["issue_type", "event_id"]}}
      ]
    },
    "paidAudit": {
      "type": "object",
      "required": ["as_of", "campaign_id", "coverage_mode", "complete_for_decision", "evidence_ids", "decisions"],
      "properties": {
        "as_of": {"$ref": "#/$defs/auditTime"},
        "campaign_id": {"$ref": "#/$defs/auditText"},
        "coverage_mode": {"enum": ["full_sweep", "isolated_risk_reduction"]},
        "decision_context": {"const": "creative_test"},
        "complete_for_decision": {"type": "boolean"},
        "evidence_ids": {"$ref": "#/$defs/auditRefs"},
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity_id", "binding_epoch", "observed_paid_delivery", "disposition", "evidence_ids"],
            "properties": {
              "entity_id": {"$ref": "#/$defs/auditText"},
              "binding_epoch": {"type": ["string", "null"], "minLength": 1},
              "observed_paid_delivery": {"type": ["boolean", "null"]},
              "disposition": {"enum": ["continue", "reduce", "rotate", "no_paid_delivery", "unknown"]},
              "evidence_ids": {"$ref": "#/$defs/auditRefs"},
              "continuation": {"$ref": "#/$defs/auditContinuation"},
              "performance_review": {"$ref": "#/$defs/creativePerformanceReview"},
              "action_review": {
                "type": "object",
                "required": ["rationale", "parent_effect", "counterevidence", "next_read_at"],
                "properties": {
                  "rationale": {"$ref": "#/$defs/auditText"},
                  "parent_effect": {"$ref": "#/$defs/auditText"},
                  "counterevidence": {"$ref": "#/$defs/auditText"},
                  "next_read_at": {"$ref": "#/$defs/auditTime"},
                  "retention_override_evidence_ids": {"$ref": "#/$defs/auditRefs"},
                  "creative_test_basis": {"$ref": "#/$defs/creativeTestBasis"}
                }
              }
            },
            "allOf": [
              {
                "if": {"properties": {"observed_paid_delivery": {"const": true}}},
                "then": {"properties": {"disposition": {"enum": ["continue", "reduce", "rotate"]}}}
              },
              {
                "if": {"properties": {"disposition": {"const": "continue"}}},
                "then": {"required": ["continuation"], "properties": {"observed_paid_delivery": {"const": true}}}
              },
              {
                "if": {"properties": {"disposition": {"const": "no_paid_delivery"}}},
                "then": {"properties": {"observed_paid_delivery": {"const": false}}}
              },
              {
                "if": {"properties": {"disposition": {"enum": ["reduce", "rotate"]}}},
                "then": {"required": ["action_review"]}
              }
            ]
          }
        }
      },
      "if": {"required": ["decision_context"]},
      "then": {"properties": {"decisions": {"items": {
        "allOf": [
          {"if": {"properties": {"disposition": {"enum": ["reduce", "rotate"]}}},
           "then": {"properties": {"action_review": {"required": ["creative_test_basis"]}}}},
          {"if": {"properties": {"observed_paid_delivery": {"const": true}}}, "then": {"required": ["performance_review"]}},
          {"if": {"properties": {"disposition": {"const": "continue"}}},
           "then": {"properties": {"continuation": {"required": ["watch_contract"]}}}}
        ]
      }}}}
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "operating_class",
    "scope",
    "decision",
    "evidence",
    "metrics",
    "data_quality",
    "diagnosis",
    "plan",
    "unknowns"
  ],
  "properties": {
    "schema_version": {"enum": ["1.2", "1.3", "1.4"]},
    "created_at": {"type": "string", "format": "date-time"},
    "operating_class": {
      "enum": ["read_only", "prepare", "execute", "monitor"]
    },
    "scope": {
      "type": "object",
      "required": ["platforms", "accounts", "markets", "currency", "timezone", "reporting_window", "business_outcome", "optimization_event", "attribution", "conversion_lag"],
      "properties": {
        "platforms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "accounts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "entities": {"type": "array", "items": {"type": "string"}},
        "markets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "currency": {"type": ["string", "null"]},
        "timezone": {"type": "string", "minLength": 1},
        "reporting_window": {"type": "string", "minLength": 1},
        "comparison_window": {"type": ["string", "null"]},
        "business_outcome": {"type": "string", "minLength": 1},
        "optimization_event": {"type": ["string", "null"]},
        "attribution": {"type": ["string", "null"]},
        "report_time": {"$ref": "#/$defs/auditText"},
        "conversion_lag": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": ["state", "summary", "owner", "deadline", "confidence", "evidence_rung", "causal_claim"],
      "properties": {
        "state": {"enum": ["act", "test", "hold", "monitor", "revert"]},
        "summary": {"type": "string", "minLength": 1},
        "owner": {"type": ["string", "null"]},
        "deadline": {"type": ["string", "null"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "evidence_rung": {"type": "integer", "minimum": 1, "maximum": 6},
        "causal_claim": {"type": "boolean"},
        "claim_type": {"enum": ["operational", "descriptive", "profitability", "superiority", "inferiority", "causal"]},
        "claim_sufficiency": {
          "type": "object",
          "required": ["method", "result", "source_ids"],
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "result": {"enum": ["supported", "unsupported", "unknown"]},
            "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "claim", "source", "retrieved_at", "limitations"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"enum": ["verified_fact", "derived_metric", "inference", "practitioner_heuristic", "assumption", "unknown"]},
          "claim": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": ["string", "null"]},
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "unit", "source_id", "window", "timezone", "currency", "attribution", "conversion_definition", "count", "denominator", "evidence_label"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {"type": ["number", "string", "null"]},
          "unit": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "window": {"type": "string", "minLength": 1},
          "timezone": {"type": "string", "minLength": 1},
          "currency": {"type": ["string", "null"]},
          "attribution": {"type": ["string", "null"]},
          "conversion_definition": {"type": ["string", "null"]},
          "count": {"type": ["number", "null"]},
          "denominator": {"type": ["number", "null"]},
          "evidence_label": {"enum": ["verified_fact", "derived_metric", "inference", "practitioner_heuristic", "assumption", "unknown"]}
        },
        "additionalProperties": true
      }
    },
    "data_quality": {
      "type": "object",
      "required": ["state", "reconciliation", "binding", "critical_issues"],
      "properties": {
        "state": {"enum": ["pass", "pass_with_limits", "fail"]},
        "reconciliation": {"enum": ["reconciled", "partially_reconciled", "unreconciled", "unavailable", "not_applicable"]},
        "binding": {"enum": ["verified", "partial", "unverified", "not_applicable"]},
        "critical_issues": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "capability_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tool", "method", "mutability", "retrieved_at"],
        "properties": {
          "tool": {"type": "string", "minLength": 1},
          "endpoint": {"type": ["string", "null"]},
          "method": {"type": "string", "minLength": 1},
          "mutability": {"enum": ["read", "write", "mixed_dispatcher", "unknown"]},
          "permissions": {"type": ["string", "null"]},
          "limits_or_latency": {"type": "array", "items": {"type": "string"}},
          "retrieved_at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": true
      }
    },
    "capability_snapshot": {
      "type": "object",
      "required": ["connector", "host", "loading_mode", "retrieved_at"],
      "properties": {
        "connector": {"type": "string", "minLength": 1},
        "host": {"type": "string", "minLength": 1},
        "loading_mode": {"type": "string", "minLength": 1},
        "guidance_source": {"type": ["string", "null"]},
        "guidance_retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "native_tool_count": {"type": ["integer", "null"], "minimum": 0},
        "discovered_tool_count": {"type": ["integer", "null"], "minimum": 0},
        "group_count": {"type": ["integer", "null"], "minimum": 0},
        "retrieved_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "account_review": {
      "type": "object",
      "required": ["mode", "coverage", "objective_routing"],
      "properties": {
        "mode": {"enum": ["cold_start", "launch_check", "mid_flight_diagnosis", "full_account_audit", "benchmark", "weekly_business_review", "portfolio_decision", "monitor"]},
        "maturity_evidence": {"type": "array", "items": {"type": "string"}},
        "coverage": {
          "type": "object",
          "required": ["expected", "observed", "unique", "missing", "duplicate"],
          "properties": {
            "expected": {"type": ["integer", "null"], "minimum": 0},
            "observed": {"type": "integer", "minimum": 0},
            "unique": {"type": "integer", "minimum": 0},
            "missing": {"type": ["integer", "null"], "minimum": 0},
            "duplicate": {"type": "integer", "minimum": 0},
            "product_families": {"type": "object"}
          },
          "additionalProperties": true
        },
        "objective_routing": {"type": "string", "minLength": 1},
        "native_diagnostics": {"type": "array", "items": {"type": "object"}},
        "change_map": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "benchmark": {
      "type": "object",
      "required": ["peer_definition", "metric", "method", "peer_count", "decision_use"],
      "properties": {
        "peer_definition": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "peer_count": {"type": "integer", "minimum": 2},
        "missing_or_ineligible": {"type": "array", "items": {"type": "string"}},
        "decision_use": {"const": "descriptive_context_only"}
      },
      "additionalProperties": true
    },
    "funnel": {
      "type": "object",
      "required": ["source", "count_semantics", "lag_state", "stages"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "count_semantics": {"enum": ["unique_entities", "events", "other"]},
        "lag_state": {"enum": ["complete", "not_applicable", "incomplete", "unknown"]},
        "stages": {"type": "array", "minItems": 2, "items": {"type": "object"}},
        "root_cause_state": {"enum": ["verified", "inference", "unknown"]}
      },
      "additionalProperties": true
    },
    "external_outcome_binding": {
      "type": "object",
      "required": ["source", "binding_state", "outcome_definition", "availability_lag"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "binding_state": {"enum": ["verified", "partial", "unverified", "not_applicable"]},
        "outcome_definition": {"type": "string", "minLength": 1},
        "availability_lag": {"type": "string", "minLength": 1},
        "model_provenance": {"type": ["object", "null"]},
        "realized_outcome_available": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "economics": {
      "type": "object",
      "required": ["acquisition_unit", "revenue_basis", "target_source", "scenarios", "marginal_implication", "capacity_constraints"],
      "properties": {
        "acquisition_unit": {"type": "string", "minLength": 1},
        "revenue_basis": {"type": "string", "minLength": 1},
        "target_source": {"type": "string", "minLength": 1},
        "scenarios": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "marginal_implication": {"type": "string", "minLength": 1},
        "capacity_constraints": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "diagnosis": {
      "type": "object",
      "required": ["observation", "leading_hypothesis", "alternatives", "confounds", "discriminator"],
      "properties": {
        "observation": {"type": "string", "minLength": 1},
        "leading_hypothesis": {"type": "string", "minLength": 1},
        "alternatives": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "confounds": {"type": "array", "items": {"type": "string"}},
        "discriminator": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "plan": {
      "type": "object",
      "required": ["action", "money_moving", "owner", "primary_metric", "guardrails", "monitoring_window", "decision_rule", "reversal_condition", "threshold_records"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "money_moving": {"type": "boolean"},
        "owner": {"type": ["string", "null"]},
        "primary_metric": {"type": "string", "minLength": 1},
        "guardrails": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "monitoring_window": {"type": "string", "minLength": 1},
        "decision_rule": {"type": "string", "minLength": 1},
        "reversal_condition": {"type": "string", "minLength": 1},
        "exposure_direction": {"enum": ["increase", "reduce", "rotate", "continue", "none"]},
        "decision_basis": {
          "type": "object",
          "required": ["kind", "rationale", "source_ids", "counterevidence"],
          "properties": {
            "kind": {"enum": ["qualitative_risk", "economics", "experiment", "diagnostic"]},
            "rationale": {"type": "string", "minLength": 1},
            "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "counterevidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "unresolved_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reason", "scope", "blocked_directions", "blocked_claims"],
            "properties": {
              "reason": {"type": "string", "minLength": 1},
              "scope": {"type": "string", "minLength": 1},
              "blocked_directions": {"type": "array", "items": {"enum": ["increase", "reduce", "rotate", "continue", "none"]}},
              "blocked_claims": {"type": "array", "items": {"enum": ["operational", "descriptive", "profitability", "superiority", "inferiority", "causal"]}}
            }
          }
        },
        "continuation": {
          "type": "object",
          "required": ["since_previous_review", "last_outcomes", "exposure_context", "cost_of_waiting", "cost_of_stopping", "next_information", "continuation_rationale", "next_review", "decision_trigger", "trigger_response"],
          "properties": {
            "since_previous_review": {"type": "string", "minLength": 1},
            "last_outcomes": {"type": "string", "minLength": 1},
            "exposure_context": {"type": "string", "minLength": 1},
            "cost_of_waiting": {"type": "string", "minLength": 1},
            "cost_of_stopping": {"type": "string", "minLength": 1},
            "next_information": {"type": "string", "minLength": 1},
            "continuation_rationale": {"type": "string", "minLength": 1},
            "next_review": {"type": "string", "minLength": 1},
            "decision_trigger": {"type": "string", "minLength": 1},
            "trigger_response": {"type": "string", "minLength": 1}
          }
        },
        "threshold_records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "rule", "origin", "source", "derivation", "scope", "approval_state", "approver"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "rule": {"type": "string", "minLength": 1},
              "origin": {"enum": ["business_derived", "account_derived", "design_derived", "runtime_platform_derived", "proposed_governance"]},
              "source": {"type": "string", "minLength": 1},
              "derivation": {"type": "string", "minLength": 1},
              "scope": {"type": "string", "minLength": 1},
              "approval_state": {"enum": ["approved", "proposed", "not_required", "unknown"]},
              "approver": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          }
        },
        "safety_exception": {"type": "object"}
      },
      "additionalProperties": true
    },
    "experiment": {
      "type": "object",
      "required": ["hypothesis", "causal_rung", "arms", "assignment", "primary_metric", "guardrails", "sufficiency_method", "lag_window", "decision_rule"],
      "properties": {
        "hypothesis": {"type": "string", "minLength": 1},
        "causal_rung": {"type": "integer", "minimum": 1, "maximum": 6},
        "arms": {"type": "array", "minItems": 2, "items": {"type": "object"}},
        "assignment": {"type": "string", "minLength": 1},
        "primary_metric": {"type": "string", "minLength": 1},
        "guardrails": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "sufficiency_method": {"type": "string", "minLength": 1},
        "lag_window": {"type": "string", "minLength": 1},
        "decision_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "required": ["approval", "changes", "preflight", "readback", "rollback", "execution_state"],
      "properties": {
        "approval": {
          "type": "object",
          "required": ["status", "approved_by", "approved_at", "scope"],
          "properties": {
            "status": {"enum": ["approved", "not_approved"]},
            "approved_by": {"type": ["string", "null"]},
            "approved_at": {"type": ["string", "null"]},
            "scope": {"type": "string", "minLength": 1}
          }
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["platform", "account_id", "entity_type", "entity_id", "field", "current_value", "proposed_value", "absolute_delta", "percentage_delta", "financial_exposure"],
            "properties": {
              "platform": {"type": "string", "minLength": 1},
              "account_id": {"type": "string", "minLength": 1},
              "entity_type": {"type": "string", "minLength": 1},
              "entity_id": {"type": "string", "minLength": 1},
              "field": {"type": "string", "minLength": 1},
              "current_value": {},
              "proposed_value": {},
              "absolute_delta": {"type": ["number", "null"]},
              "percentage_delta": {"type": ["number", "null"]},
              "financial_exposure": {
                "type": "object",
                "required": ["currency", "model", "period_count", "budget_ceiling_per_period", "maximum_incremental_amount", "horizon", "derivation"],
                "properties": {
                  "currency": {"type": "string", "minLength": 1},
                  "model": {"enum": ["direct_amount_delta", "amount_delta_times_periods", "budget_ceiling_times_periods", "bounded_other"]},
                  "period_count": {"type": ["number", "null"], "minimum": 0},
                  "budget_ceiling_per_period": {"type": ["number", "null"], "minimum": 0},
                  "maximum_incremental_amount": {"type": "number", "minimum": 0},
                  "horizon": {"type": "string", "minLength": 1},
                  "derivation": {"type": "string", "minLength": 1},
                  "amount_semantics": {"enum": ["nominal_reference", "verified_bound"]},
                  "bound_evidence": {"type": "string", "minLength": 1}
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "preflight": {
          "type": "object",
          "required": ["fresh_state_at", "currency_checked", "timezone_checked", "experiment_impact", "dependencies_checked", "validation_result"],
          "properties": {
            "fresh_state_at": {"type": "string", "minLength": 1},
            "currency_checked": {"type": "boolean"},
            "timezone_checked": {"type": "boolean"},
            "experiment_impact": {"type": "string", "minLength": 1},
            "dependencies_checked": {"type": "boolean"},
            "validation_result": {"type": "string", "minLength": 1}
          }
        },
        "readback": {
          "type": "object",
          "required": ["tool", "query", "success_predicate", "expected_state", "observed_at", "observed_state"],
          "properties": {
            "tool": {"type": "string", "minLength": 1},
            "query": {"type": "string", "minLength": 1},
            "success_predicate": {"type": "string", "minLength": 1},
            "expected_state": {"type": "object", "minProperties": 1},
            "observed_at": {"type": ["string", "null"]},
            "observed_state": {
              "oneOf": [
                {"type": "object", "minProperties": 1},
                {"type": "null"}
              ]
            }
          }
        },
        "rollback": {
          "type": "object",
          "required": ["exact_previous_state", "trigger", "authority", "verification_query"],
          "properties": {
            "exact_previous_state": {"type": "object"},
            "trigger": {"type": "string", "minLength": 1},
            "authority": {"type": "string", "minLength": 1},
            "verification_query": {"type": "string", "minLength": 1}
          }
        },
        "execution_state": {
          "enum": ["validated_only", "accepted", "applied", "delivering", "outcome_measured", "commercially_validated", "partial_failure", "readback_mismatch", "unknown"]
        }
      },
      "additionalProperties": true
    },
    "paid_audit": {"$ref": "#/$defs/paidAudit"},
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unknown", "decision_impact", "cheapest_evidence", "owner"],
        "properties": {
          "unknown": {"type": "string", "minLength": 1},
          "decision_impact": {"type": "string", "minLength": 1},
          "cheapest_evidence": {"type": "string", "minLength": 1},
          "owner": {"type": ["string", "null"]}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"enum": ["1.3", "1.4"]}}, "required": ["schema_version"]},
      "then": {
        "properties": {
          "decision": {
            "required": ["claim_type"],
            "allOf": [
              {
                "if": {"properties": {"claim_type": {"enum": ["superiority", "inferiority"]}}, "required": ["claim_type"]},
                "then": {"required": ["claim_sufficiency"], "properties": {"claim_sufficiency": {"properties": {"result": {"const": "supported"}}}}}
              },
              {
                "if": {"properties": {"claim_type": {"const": "causal"}}, "required": ["claim_type"]},
                "then": {"properties": {"causal_claim": {"const": true}}}
              }
            ]
          },
          "plan": {
            "required": ["exposure_direction", "decision_basis", "unresolved_gates"],
            "allOf": [
              {
                "if": {"properties": {"exposure_direction": {"enum": ["increase", "reduce", "rotate"]}}, "required": ["exposure_direction"]},
                "then": {"properties": {"money_moving": {"const": true}}},
                "else": {"properties": {"money_moving": {"const": false}}}
              }
            ]
          },
          "execution": {
            "properties": {
              "changes": {
                "items": {
                  "properties": {
                    "financial_exposure": {
                      "required": ["amount_semantics"],
                      "allOf": [{
                        "if": {"properties": {"amount_semantics": {"const": "verified_bound"}}, "required": ["amount_semantics"]},
                        "then": {"required": ["bound_evidence"]}
                      }]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.3"},
          "plan": {"required": ["exposure_direction"], "properties": {"exposure_direction": {"const": "continue"}}}
        },
        "required": ["schema_version", "plan"]
      },
      "then": {"properties": {"plan": {"required": ["continuation"]}}}
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.4"},
          "plan": {"required": ["exposure_direction"], "properties": {"exposure_direction": {"const": "continue"}}}
        },
        "required": ["schema_version", "plan"]
      },
      "then": {"required": ["paid_audit"]}
    },
    {
      "if": {"required": ["paid_audit"]},
      "then": {"properties": {"schema_version": {"const": "1.4"}, "scope": {"required": ["report_time"]}}}
    },
    {
      "if": {
        "required": ["paid_audit", "decision", "plan"],
        "properties": {
          "decision": {"required": ["state"], "properties": {"state": {"const": "hold"}}},
          "plan": {"required": ["exposure_direction"], "properties": {"exposure_direction": {"const": "none"}}}
        }
      },
      "then": {
        "properties": {
          "paid_audit": {
            "properties": {
              "decisions": {"not": {"contains": {"required": ["observed_paid_delivery"], "properties": {"observed_paid_delivery": {"const": true}}}}}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"operating_class": {"const": "execute"}},
        "required": ["operating_class"]
      },
      "then": {
        "required": ["capability_manifest", "execution"],
        "properties": {
          "capability_manifest": {
            "minItems": 2,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": ["mutability"],
                  "properties": {"mutability": {"const": "read"}}
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": ["mutability"],
                  "properties": {"mutability": {"const": "write"}}
                }
              },
              {
                "not": {
                  "contains": {
                    "type": "object",
                    "required": ["mutability"],
                    "properties": {
                      "mutability": {"enum": ["mixed_dispatcher", "unknown"]}
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "not": {"required": ["execution"]}
      }
    }
  ],
  "additionalProperties": true
}
